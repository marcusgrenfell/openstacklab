[all:vars]
ansible_user=${yourname}
ansible_ssh_common_args='-o StrictHostKeyChecking=no'
ansible_become=true
ansible_ssh_private_key_file=id_rsa.pem
openstack_password=${password}

[deployment]
%{ for node in deployment ~}
${node.ip}
%{ endfor ~}

[compute]
%{ for node in compute ~}
${node.ip}
%{ endfor ~}

[control]
%{ for node in controller ~}
${node.ip}
%{ endfor ~}

[ceph:children]
compute